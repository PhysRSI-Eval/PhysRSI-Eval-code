          },
          "gripper_closed": {
           "type": "boolean"
          }
         },
         "required": [
          "position",
          "quaternion_wxyz",
          "gripper_closed"
         ],
         "additionalProperties": false
        }
       },
       "required": [
        "left",
        "right"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "request_id",
      "mode",
      "reason",
      "steps",
      "target"
     ],
     "additionalProperties": false
    }
   },
   {
    "type": "function",
    "name": "r1_notes",
